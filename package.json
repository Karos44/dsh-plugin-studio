{
  "name": "dsh-plugin-studio",
  "version": "0.1.1",
  "description": "Customizable DSH plugin grid, persistent appearance overrides, import/export and safe version management",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "license": "MIT",
  "engines": {"node": ">=18", "dsh": ">=0.2.1-rc.0 <0.3.0-0"},
  "dsh": {
    "manifestVersion": 1,
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ./build.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "check": "node --check ./dist/client.js && node --check ./dist/index.js && node --check ./dist/store.js"
  }
}
